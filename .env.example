# ==============================================================================
# ENVIRONMENT CONFIGURATION - DISTRIBUTED OCR AGENTIC RAG SYSTEM
# ==============================================================================

# Application Environment & Security
APP_NAME="Distributed OCR Agentic RAG"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="change-me-to-a-secure-random-secret-key"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:8000"]

# PostgreSQL Database Configuration
# Note: Host port is 5433 when mapped from Docker container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocr_rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ocr_rag_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/ocr_rag_db

# Redis & Celery Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO S3-Compatible Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_DOCUMENTS=ocr-documents
MINIO_BUCKET_ARTIFACTS=ocr-artifacts
MINIO_BUCKET_EXPORT=ocr-exports

# Milvus Vector Database Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=""
MILVUS_PASSWORD=""
MILVUS_COLLECTION_NAME=document_chunks
MILVUS_EMBEDDING_DIM=384

# Persistent BM25 Storage Configuration
BM25_STORAGE_DIR=data/bm25_indices

# Embedding & Reranking Models (CPU Optimized)
# Embedding dimension: 384 for bge-small-en-v1.5 and all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# OCR Engine Configurations
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_LANGUAGES="eng"
ENABLE_PADDLEOCR=true
PADDLEOCR_USE_ANGLE_CLS=true
PADDLEOCR_LANG="en"
OCR_CONFIDENCE_THRESHOLD=60.0
OCR_ENGINE_DEFAULT="hybrid"

# Agentic AI & Groq LLM Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL_NAME="llama-3.1-70b-versatile"
GROQ_TEMPERATURE=0.1
MAX_AGENT_ITERATIONS=5

# Web Search Configuration
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10

# System Limits & Resilience Guardrails
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg", "tiff", "tif", "bmp", "webp", "docx", "doc", "txt", "rtf", "md", "html", "xlsx", "xls", "csv", "pptx", "ppt", "xml"]
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30
